rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles collection
    // Stored at /users/{userId}
    match /users/{userId} {
      // Any authenticated user can read user profiles (needed for student list, teacher badges, cohorts)
      allow read: if isAuthenticated();

      // Users can create/update their own profile
      allow create, update: if isOwner(userId);

      // Allow admin moderation or owner deletion
      allow delete: if isOwner(userId) || (isAuthenticated() && request.auth.token.role == 'admin');
    }

    // Cohorts & assigned experiments
    match /cohorts/{cohortId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Private classroom labs & assessments
    match /private_labs/{labId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Student lab results, assessments and simulations
    match /lab_results/{resultId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid);
    }
  }
}


