rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin check: supports Firebase Auth token custom claim OR verified designated admin emails
    // (Jayesh, Om, Dipali, Vaishnavi)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'jayeshkoli106@gmail.com',
          'omchaudhari0365@gmail.com',
          'dipaliishi2006@gmail.com',
          'vaishnavigirase802@gmail.com'
        ]
      );
    }

    // ── User Profiles ──
    // Stored at /users/{userId}
    match /users/{userId} {
      // Users can read their own profile; admins can read any profile
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their own profile document
      allow create: if isOwner(userId);

      // Users can update their own profile, BUT cannot self-escalate role or permissions
      // Only admins can modify the 'role' and 'permissions' fields
      allow update: if isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions'])
            || isAdmin());

      // Only the user themselves or an admin can delete a profile
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Cohorts & Assigned Experiments ──
    match /cohorts/{cohortId} {
      // Authenticated users can read cohorts they belong to
      allow read: if isAuthenticated();

      // Only admins can create/modify/delete cohorts
      allow write: if isAdmin();
    }

    // ── Private Classroom Labs & Assessments ──
    match /private_labs/{labId} {
      // Authenticated users can read labs (necessary for students to join by lab code)
      allow read: if isAuthenticated();

      // Any authenticated teacher can create a new lab (teacherId must match authenticated user)
      allow create: if isAuthenticated()
        && request.resource.data.teacherId == request.auth.uid;

      // Teachers who own the lab or admins can update any field;
      // Students can only update 'enrolledStudents' and 'submissions' arrays
      allow update: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledStudents', 'submissions'])
      );

      // Only the owning teacher or an admin can delete a lab
      allow delete: if isAuthenticated()
        && (resource.data.teacherId == request.auth.uid || isAdmin());
    }

    // ── Student Lab Results ──
    match /lab_results/{resultId} {
      // Students can read their own results; admins can read all
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());

      // Students can create their own results (userId must match)
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // Students can update/delete only their own results
      allow update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }
  }
}
